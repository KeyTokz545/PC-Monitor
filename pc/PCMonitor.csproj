<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PCMonitor</AssemblyName>
    <RootNamespace>PCMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.6.0</Version>
    <!-- léger : un seul tas mémoire compact, pas de fil de nettoyage en arrière-plan -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <Product>PC Monitor</Product>
    <Company>KeyTokz545</Company>
    <Description>Monitoring et contrôle du PC depuis un téléphone</Description>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- dynamic + COM (WScript.Shell) : pas de suppression de code -->
    <PublishTrimmed>false</PublishTrimmed>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- le ramasse-miettes compacte davantage pour garder peu de mémoire -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.28" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\dashboard.html" LogicalName="dashboard.html" />
    <EmbeddedResource Include="wwwroot\icon.png" LogicalName="icon.png" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Resources\IntelMSR.bin" LogicalName="IntelMSR.bin" />
  </ItemGroup>

</Project>
