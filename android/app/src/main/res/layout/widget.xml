<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_dot_off"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_pc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="PC Monitor"
            android:textColor="#E4ECF2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="#7F93A6"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#7F93A6"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_temps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_cpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–"
                android:textColor="#E4ECF2"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU"
                android:textColor="#7F93A6"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_gpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–"
                android:textColor="#E4ECF2"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPU"
                android:textColor="#7F93A6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/w_m_silent" style="@style/WidgetBtn" android:text="Silence" />
        <TextView android:id="@+id/w_m_balanced" style="@style/WidgetBtn" android:text="Équilibré" />
        <TextView android:id="@+id/w_m_turbo" style="@style/WidgetBtn" android:text="Turbo" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_cpu_row"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/w_c_silent" style="@style/WidgetBtn" android:text="Léger" />
        <TextView android:id="@+id/w_c_balanced" style="@style/WidgetBtn" android:text="Médium" />
        <TextView android:id="@+id/w_c_turbo" style="@style/WidgetBtn" android:text="Gros" />
    </LinearLayout>
</LinearLayout>
